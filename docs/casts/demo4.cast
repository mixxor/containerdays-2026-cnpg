[3.497, "o", "{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:23.509178834Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Resetting WAL archives                                        ok\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:23.524480917Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Setting the default char signedness for new cluster           ok\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:23.653925209Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Setting frozenxid and minmxid counters in new cluster         ok\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:23.663322167Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Restoring global objects in the new cluster                   ok\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:23.745357042Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Restoring database schemas in the new cluster                 ok\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r"]
[0.0, "o", "\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:29.893255628Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Adding \\\".old\\\" suffix to old \\\"global/pg_control\\\"               ok\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:29.893375712Z\",\"logger\":\"pg_upgrade\",\"msg\":\"If you want to start the old cluster, you will need to remove\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:29.893476628Z\",\"logger\":\"pg_upgrade\",\"msg\":\"the \\\".old\\\" suffix from \\\"/var/lib/postgresql/data/pgdata/global/pg_control.old\\\".\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:29.893506587Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Because \\\"link\\\" mode was used, the old cluster cannot be safely\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n"]
[0.0, "o", "{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:29.893523087Z\",\"logger\":\"pg_upgrade\",\"msg\":\"started once the new cluster has been started.\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n{\"level\":\"info\",\"ts\":\"2026-08-26T21:56:29.894335045Z\",\"logger\":\"pg_upgrade\",\"msg\":\"Linking user relation files                                   ok\",\"pipe\":\"stdout\",\"logging_pod\":\"hafen-1-major-upgrade\"}\r\n"]
